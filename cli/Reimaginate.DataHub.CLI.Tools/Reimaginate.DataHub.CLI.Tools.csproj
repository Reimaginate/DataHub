<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Reimaginate.DataHub.CLI.Tools</PackageId>
    <Description>Reusable DataHub command handlers and services for Reimaginate CLI hosts.</Description>
    <PackageTags>datahub;cli;tools;reimaginate</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.86.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="Reimaginate.CLI.Base" Version="1.0.2" />
    <PackageReference Include="Reimaginate.Mediator.Abstractions" Version="1.3.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\Reimaginate.DataHub.Client\Reimaginate.DataHub.Client.csproj" />
    <ProjectReference Include="..\..\framework\Reimaginate.DataHub.SharedModels\Reimaginate.DataHub.SharedModels.csproj" />
  </ItemGroup>

</Project>
