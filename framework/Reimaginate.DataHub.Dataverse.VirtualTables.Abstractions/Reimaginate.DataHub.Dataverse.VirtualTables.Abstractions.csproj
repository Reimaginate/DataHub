<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Abstractions for DataHub Dataverse virtual table integrations and mediator-based virtual table request contracts.</Description>
		<PackageTags>datahub;dataverse;virtual-tables;abstractions;contracts;reimaginate</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Reimaginate.Mediator.Abstractions" Version="1.3.0" />
	</ItemGroup>

</Project>
