<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Core DataHub runtime for request handling, data operations, validation, telemetry, and persistence integration.</Description>
		<PackageTags>datahub;runtime;cosmos;validation;opentelemetry</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Requests\External\Events\**" />
	  <EmbeddedResource Remove="Requests\External\Events\**" />
	  <None Remove="Requests\External\Events\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Monitor.Query.Logs" Version="1.0.0" />
		<PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
		<PackageReference Include="JsonDiffPatch.Net" Version="2.5.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="OpenTelemetry" Version="1.17.0" />
		<PackageReference Include="Polly" Version="8.7.0" />
		<PackageReference Include="Reimaginate.DataServices.Cosmos" Version="1.3.0" />
		<PackageReference Include="Reimaginate.Mapper.Abstractions" Version="1.3.0" />
		<PackageReference Include="Reimaginate.Mapper.SourceGenerator" Version="1.3.0" />
		<PackageReference Include="Reimaginate.Mediator.Abstractions" Version="1.3.0" />
		<PackageReference Include="Reimaginate.Mediator.SourceGenerator" Version="1.3.0" />
		<PackageReference Include="Reimaginate.ProcessingLockService" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Reimaginate.DataHub.SharedModels\Reimaginate.DataHub.SharedModels.csproj" />
	</ItemGroup>

</Project>
