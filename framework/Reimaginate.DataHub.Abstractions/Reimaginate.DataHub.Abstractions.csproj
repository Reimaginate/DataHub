<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Core contracts and abstractions for defining DataHub requests, operations, and shared integration boundaries.</Description>
		<PackageTags>datahub;abstractions;contracts;requests;reimaginate</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Reimaginate.Mediator.Abstractions" Version="1.3.0" />
	</ItemGroup>

</Project>
