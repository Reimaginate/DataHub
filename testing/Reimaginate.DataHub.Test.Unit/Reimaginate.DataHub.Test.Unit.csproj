<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Reimaginate.DataHub.Test.Unit</AssemblyName>
    <RootNamespace>Reimaginate.DataHub.Test.Unit</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.3.2" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="Reimaginate.DataHub.Agent" Version="1.3.0-rc.36" />
    <PackageReference Include="Reimaginate.Test.Framework" Version="1.3.0" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\framework\Reimaginate.DataHub\Reimaginate.DataHub.csproj" />
    <ProjectReference Include="..\..\framework\Reimaginate.DataHub.AspNetCore\Reimaginate.DataHub.AspNetCore.csproj" />
    <ProjectReference Include="..\..\framework\Reimaginate.DataHub.Client\Reimaginate.DataHub.Client.csproj" />
    <ProjectReference Include="..\..\framework\Reimaginate.DataHub.SharedModels\Reimaginate.DataHub.SharedModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
