<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Testing helpers, fixtures, and assertions for exercising DataHub runtime and client integrations.</Description>
		<PackageTags>datahub;testing;fixtures;test-framework;reimaginate</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Bogus" Version="35.6.5" />
		<PackageReference Include="FluentAssertions" Version="6.12.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
		<PackageReference Include="Reimaginate.Test.Framework" Version="1.3.0" />
		<PackageReference Include="NSubstitute" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\framework\Reimaginate.DataHub.Client\Reimaginate.DataHub.Client.csproj" />
		<ProjectReference Include="..\..\framework\Reimaginate.DataHub\Reimaginate.DataHub.csproj" />
	</ItemGroup>

</Project>
